{
  "version": 1,
  "author": "Ajay Chowdary Uppalapati",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot", "top": -110, "left": -150, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -120, "left": 120, "attrs": {} },
    { "type": "wokwi-led", "id": "pump", "top": 170, "left": 170, "attrs": { "color": "blue" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 230, "left": 160, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pot:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot:SIG", "esp:34", "green", [ "v0" ] ],
    [ "dht:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "dht:SDA", "esp:4", "blue", [ "v0" ] ],
    [ "esp:26", "pump:A", "orange", [ "v0" ] ],
    [ "pump:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
